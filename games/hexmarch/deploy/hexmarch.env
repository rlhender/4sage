# Settings for the Hexmarch server. Copy to /etc/hexmarch.env.

# Listen only on this machine; the reverse proxy faces the internet.
# To try the game without a proxy, set HOST=0.0.0.0 and open the port.
HOST=127.0.0.1
PORT=3000

# Where rooms and finished-game records are kept. Without this, a restart
# ends every game.
DATA_DIR=/var/lib/hexmarch

# Milliseconds each phase lasts by default (hosts can change it
# per room). Language models can be slow; raise this if they time out.
PHASE_MS=180000

# How long to wait before moving for players who have all disconnected.
GRACE_MS=30000

# Rooms nobody has touched for this long are removed.
ROOM_TTL_MS=86400000
